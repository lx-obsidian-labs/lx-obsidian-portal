# Non-secret Worker variables, already in wrangler.jsonc. Workers AI uses its binding, not a key.
FIREBASE_PROJECT_ID=vista-cinema
AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Put these in the project root .env for node backend/deploy.mjs.
# The NVIDIA key is uploaded as a Cloudflare Worker secret, never sent to Android.
NVIDIA_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# News retrieval and cloud speech are backend-only secrets. Onboarding writes the speech key
# to root .env.local; loadEnvironment() reads it without including it in Android builds.
NEWSDATA_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
