# Cloudflare Pages Redirects

# Canonical domain: apex → www (configure in Cloudflare Dashboard
# as a Bulk Redirect Rule OR DNS-level redirect for this to work)
# NOTE: Cloudflare Pages _redirects cannot do host-level redirects.
# Set this up in Cloudflare Dashboard → Rules → Redirect Rules:
#   When: Hostname equals lxobsidianportal.co.za
#   Then: Dynamic URL = "https://www.lxobsidianportal.co.za" + uri
#   Status: 301 Permanent

# Legacy path support → clean URLs
/shop           /marketplace.html    301
/apps           /marketplace.html    301
/catalogue      /marketplace.html    301
/team           /about.html          301
/knowledge      /blog.html           301
/articles       /blog.html           301
/plans          /contact.html        301
/support        /contact.html        301
/help           /faq.html            301

# Custom 404
/404            /404.html       200

# Dashboard SPA fallback
/dashboard/*  /dashboard/index.html  200
