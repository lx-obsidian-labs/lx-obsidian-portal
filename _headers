# Security Headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://images.unsplash.com https://*.cloudflare.com; connect-src 'self' https://integrate.api.nvidia.com https://openrouter.ai https://fonts.googleapis.com https://static.cloudflareinsights.com; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'

# Cache HTML and critical assets with no-cache (always revalidate)
/
  Cache-Control: no-cache, no-store, must-revalidate
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
/css/style.css
  Cache-Control: no-cache, no-store, must-revalidate
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

# Generated artwork - immutable per deploy
/assets/generated/*
  Cache-Control: public, max-age=31536000, immutable

# Font files - cross-origin + immutable cache
/assets/fonts/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

# JS files - always revalidate
/js/*
  Cache-Control: no-cache, must-revalidate

# CSS files - cache for 1 hour, revalidate
/css/*
  Cache-Control: public, max-age=3600, must-revalidate

# Images - cache for 1 week
/assets/*.png
  Cache-Control: public, max-age=604800, immutable
/assets/*.svg
  Cache-Control: public, max-age=604800, immutable
/assets/*.webp
  Cache-Control: public, max-age=604800, immutable

# API endpoints - no cache
/api/*
  Access-Control-Allow-Origin: https://www.lxobsidianportal.co.za
  Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization
  Cache-Control: no-cache, no-store
