{
  "name": "lx-obsidian-portal",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js && npm run check",
    "dev": "npm run build && npx wrangler pages dev dist --compatibility-date=2024-09-23",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name lxobsidianmainsite",
    "db:migrate": "node scripts/database-guard.js",
    "db:seed": "node scripts/database-guard.js",
    "check": "node scripts/verify.js",
    "test": "node --test tests/*.test.cjs",
    "check:docs": "node scripts/verify-docs.js"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0",
    "wrangler": "^4.124.0"
  }
}
