{
  "name": "lx-obsidian-portal",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "npx wrangler pages dev . --compatibility-date=2024-09-23",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name lxobsidianmainsite",
    "db:migrate": "wrangler d1 migrations apply lx-obsidian-db",
    "test": "node --test tests/*.test.mjs",
    "db:init": "wrangler d1 execute lx-obsidian-db --file=db/migrations/0001_ai_platform.sql"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0",
    "wrangler": "^4.124.0"
  }
}
