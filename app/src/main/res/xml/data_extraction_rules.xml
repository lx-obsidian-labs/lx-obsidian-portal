<?xml version="1.0" encoding="utf-8"?>
<!--
  Mirrors backup_rules.xml for Android 12+ cloud backup and device-to-device transfer.

  Backed up: shared preferences and databases, i.e. settings, watchlist, watch history and recent
  searches. Those are the viewer's own data and losing them on a device change would be the most
  annoying kind of data loss.

  Excluded: caches and any offline media. The lists below are inclusive on purpose - a domain that
  is not named is not backed up, so adding a new table later cannot quietly start shipping
  personal data to cloud backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>